ng\": {\n        \"type\": \"FLOAT\",\n        \"littleEndian\": false,\n        \"sizeInBits\": 32,\n        \"encoding\": \"IEEE754_1985\"\n      }\n    },\n    \"dataSource\": \"TELEMETERED\"\n  }, {\n    \"name\": \"Velocity\",\n    \"qualifiedName\": \"/myproject/Velocity\",\n    \"type\": {\n      \"engType\": \"aggregate\",\n      \"member\": [{\n        \"name\": \"x\",\n        \"type\": {\n          \"engType\": \"float\",\n          \"dataEncoding\": {\n            \"type\": \"FLOAT\",\n            \"littleEndian\": false,\n            \"sizeInBits\": 32,\n            \"encoding\": \"IEEE754_1985\"\n          }\n        }\n      }, {\n        \"name\": \"y\",\n        \"type\": {\n          \"engType\": \"float\",\n          \"dataEncoding\": {\n            \"type\": \"FLOAT\",\n            \"littleEndian\": false,\n            \"sizeInBits\": 32,\n            \"encoding\": \"IEEE754_1985\"\n          }\n        }\n      }, {\n        \"name\": \"z\",\n        \"type\": {\n          \"engType\": \"float\",\n          \"dataEncoding\": {\n            \"type\": \"FLOAT\",\n            \"littleEndian\": false,\n            \"sizeInBits\": 32,\n            \"encoding\": \"IEEE754_1985\"\n          }\n        }\n      }]\n    },\n    \"dataSource\": \"TELEMETERED\"\n  }, {\n    \"name\": \"numCommands\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/cmdQueue/default/numCommands\",\n    \"shortDescription\": \"Number of queued commands\",\n    \"type\": {\n      \"engType\": \"integer\",\n      \"signed\": true\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"numRejectedCommands\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/cmdQueue/default/numRejectedCommands\",\n    \"shortDescription\": \"The total number of commands that have been rejected by this queue since Yamcs has started execution\",\n    \"type\": {\n      \"engType\": \"integer\",\n      \"signed\": false\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"numSentCommands\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/cmdQueue/default/numSentCommands\",\n    \"shortDescription\": \"The total number of commands that have been sent through this queue since Yamcs has started execution\",\n    \"type\": {\n      \"engType\": \"integer\",\n      \"signed\": false\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"state\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/cmdQueue/default/state\",\n    \"shortDescription\": \"The current state of this commanding queue\",\n    \"type\": {\n      \"engType\": \"enumeration\",\n      \"enumValue\": [{\n        \"value\": \"0\",\n        \"label\": \"BLOCKED\",\n        \"description\": \"Commands are held in the queue until manually released or the queue is unblocked\"\n      }, {\n        \"value\": \"1\",\n        \"label\": \"DISABLED\",\n        \"description\": \"Commands are rejected immediately\"\n      }, {\n        \"value\": \"2\",\n        \"label\": \"ENABLED\",\n        \"description\": \"Commands pass through the queue immediately (subject to transmission constraints)\"\n      }]\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"vda1\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/df/dev/vda1\",\n    \"shortDescription\": \"Information about disk usage for the /dev/vda1 file store of type ext4\",\n    \"type\": {\n      \"engType\": \"aggregate\",\n      \"member\": [{\n        \"name\": \"total\",\n        \"shortDescription\": \"Size of the file store\",\n        \"type\": {\n          \"engType\": \"integer\",\n          \"unitSet\": [{\n            \"unit\": \"KB\"\n          }],\n          \"signed\": true\n        }\n      }, {\n        \"name\": \"available\",\n        \"shortDescription\": \"The number of bytes available to this Java Virtual Machine on the file store\",\n        \"type\": {\n          \"engType\": \"integer\",\n          \"unitSet\": [{\n            \"unit\": \"KB\"\n          }],\n          \"signed\": true\n        }\n      }, {\n        \"name\": \"percentageUse\",\n        \"shortDescription\": \"Percentage of bytes used on the file store\",\n        \"type\": {\n          \"engType\": \"float\",\n          \"unitSet\": [{\n            \"unit\": \"%\"\n          }]\n        }\n      }]\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"jvmMemoryUsed\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/jvmMemoryUsed\",\n    \"shortDescription\": \"Amount of memory currently used in the Java Virtual Machine\",\n    \"type\": {\n      \"engType\": \"integer\",\n      \"unitSet\": [{\n        \"unit\": \"KB\"\n      }],\n      \"signed\": false\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"jvmThreadCount\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/jvmThreadCount\",\n    \"shortDescription\": \"Current thread count of the Java Virtual Machine\",\n    \"type\": {\n      \"engType\": \"integer\",\n      \"signed\": false\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"jvmTotalMemory\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/jvmTotalMemory\",\n    \"shortDescription\": \"Total amount of memory allocated by the Java Virtual Machine\",\n    \"type\": {\n      \"engType\": \"integer\",\n      \"unitSet\": [{\n        \"unit\": \"KB\"\n      }],\n      \"signed\": false\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"mode\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/processor/mode\",\n    \"shortDescription\": \"The mode of the current processor (either replay or realtime)\",\n    \"type\": {\n      \"engType\": \"string\"\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"name\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/processor/name\",\n    \"shortDescription\": \"The name of the current processor\",\n    \"type\": {\n      \"engType\": \"string\"\n    },\n    \"dataSource\": \"SYSTEM\"\n  }, {\n    \"name\": \"dataInCount\",\n    \"qualifiedName\": \"/yamcs/a0556974485d/udp-in/dataInCount\"